# Copy this file to .env and fill in the values. Never commit .env.

# --- Voice (OpenAI Realtime) -------------------------------------------------
# Leave empty to run without voice: the cockpit then uses typed commands and
# the browser's built-in voice for alerts.
OPENAI_API_KEY=
# Cheap model while building; switch to the full model for the final demo,
# for example gpt-realtime-2.1 or gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Recommendations and manuals (optional) ---------------------------------------
# The key above is also used for these. Without it, the incident view shows the fixed rule based checks.
# Text model for the recommendations. Empty = pick the newest "-mini" model your key can use.
# Set it when you want a specific model, for example OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=
# Model for searching the manuals by meaning (keyword search works without it).
OPENAI_EMBED_MODEL=text-embedding-3-small
# 1 = prepare the recommendations of every incident right after a recording is analysed (a few cents).
# 0 = only when an incident is opened.
RECOMMEND_PREFETCH=1
# Only for a proxy or a test server. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Written answers to questions about the manuals (Manuals panel, chat, voice), with section and page.
OPENAI_ANSWER_MODEL=gpt-5-mini
# minimal | low | medium | high (reasoning models only); low = about 5-10 s per answer
OPENAI_ANSWER_REASONING=low
# Typed chat with the copilot when voice is off: same instructions and tools as voice.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_CHAT_REASONING=low

# --- Security ------------------------------------------------------------------
# Protects voice keys, demo controls and setting changes once the backend is
# reachable through a public link (for the judges' phones). Open the cockpit
# once with ?token=<this value>; the browser remembers it for the session.
# Leave empty only on a private network.
COCKPIT_TOKEN=change-me

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Data source ---------------------------------------------------------------
# Empty = use each sensor's source from config/sensors.yaml.
# simulator = force dummy data for every sensor (safe fallback on stage).
SOURCE_OVERRIDE=
# Use another sensor file. For the real optoNCDT 5500 (ILD5500) over Ethernet:
#   SENSORS_FILE=config/sensors.live.yaml
SENSORS_FILE=config/sensors.yaml

# --- Real sensor: optoNCDT 5500 over Ethernet (only with config/sensors.live.yaml) -------
# Run  python scripts/sensor_check.py  first, it tells you whether the connection works.
# Factory address of the sensor is 169.254.168.150; set these only when yours differs.
# The port is the one set in the sensor under Ethernet settings > Server TCP/IP (default 1024).
LIVE_SENSOR_HOST=
LIVE_SENSOR_PORT=
